# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clinic_booking
DB_USER=root
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_must_be_at_least_64_characters_long_for_hs512
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_must_be_at_least_64_characters_long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Happy Care Clinic <noreply@happycareclinic.com>

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Business Rules
MIN_LEAD_TIME_HOURS=2
CANCELLATION_FEE_PERCENT=20
NO_SHOW_FEE_PERCENT=100
MAX_BOOKING_DAYS_AHEAD=30
SLOT_DURATION_MINUTES=30
